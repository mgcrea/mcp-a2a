{
  "name": "@mgcrea/mcp-a2a",
  "version": "0.1.0",
  "description": "Model Context Protocol server bridging local agents over the A2A (Agent2Agent) protocol",
  "keywords": [
    "a2a",
    "agent2agent",
    "agents",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "Olivier Louvignes <olivier@mgcrea.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgcrea/mcp-a2a.git"
  },
  "bin": {
    "a2a-mcp": "dist/cli.js",
    "a2a-serve": "dist/serve.js",
    "mcp-a2a": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#/*": "./src/*.ts",
    "#test/*": "./test/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "pnpm dlx release-it",
    "docker:build": "BUILDER=build scripts/docker-build.sh",
    "docker:buildx": "BUILDER=buildx scripts/docker-build.sh",
    "docker:push": "docker push mgcrea/mcp-a2a:latest && docker push mgcrea/mcp-a2a:$npm_package_version",
    "docker:release": "BUILDER=buildx scripts/docker-build.sh --push",
    "prepublishOnly": "pnpm build",
    "start:serve": "node dist/serve.js",
    "dev:serve": "tsx watch src/serve.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "^2.3.1",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.1"
}
