# ── This machine's identity ──────────────────────────────────────────────────
# How this machine introduces itself in its agent card. A peer's operator reads
# this to decide whether to delegate here, so name the machine, not the software.
A2A_AGENT_NAME="olivier's mac — local coding agents"
# What the agents here are good for and what they are not. This is the one field
# a remote agent reads before choosing to send you work, so say plainly that
# inbound tasks are queued for a human-supervised agent rather than executed.
# A2A_AGENT_DESCRIPTION="..."

# ── The daemon ───────────────────────────────────────────────────────────────
# Where the A2A peer daemon listens, and where the stdio tools reach it. Both
# halves must agree, so this is ONE variable rather than a host and a port.
#
# Loopback only, and refused at startup otherwise. v1 does not serve remote
# peers: a laptop behind NAT is not addressable anyway, and exposing this
# listener needs a tunnel plus real per-peer auth. See the README's "Known
# boundaries" — this is a stated limit, not an oversight.
A2A_DAEMON_URL=http://127.0.0.1:41241

# Shared bearer token for this machine's loopback A2A mesh. The daemon requires
# it on every A2A request; every client must send the same value.
#
#   openssl rand -hex 32
#
# Leaving it unset is allowed and NOT recommended: the daemon then accepts a task
# proposal from any process on this machine. Nothing is executed by arriving — an
# inbound task waits for an agent to answer it deliberately — but an unset token
# means anything local can fill your queue.
A2A_TOKEN=

# ── Peers ────────────────────────────────────────────────────────────────────
# Peer BASE urls, comma- or whitespace-separated, so a2a_list_agents can name
# them before anything has been discovered. Not the card path: the client appends
# /.well-known/agent-card.json itself.
#
# On one machine every peer is a loopback port — a second daemon on 41242, an
# LM Studio agent server, another vendor's A2A endpoint.
# A2A_PEERS=http://127.0.0.1:41242,http://127.0.0.1:8080

# ── Safety ───────────────────────────────────────────────────────────────────
# Register the mutating tools. Off by default. With it off they are not refused,
# they are ABSENT from tools/list and cannot be called at all — a refusal still
# lets a model retry and reason about a way round, a missing tool ends it.
#
# It unlocks five tools:
#   a2a_send_message                      delegate work to another agent
#   a2a_respond_to_task                   answer an inbound proposal — this is
#                                         the act that commits you to another
#                                         agent's request, which is why it is
#                                         gated even though it only writes a
#                                         local file
#   a2a_cancel_task                       withdraw a task (destructive)
#   a2a_set_push_notification_config      ask a peer to POST updates
#   a2a_delete_push_notification_config   remove one (destructive, takes confirm)
# and widens a2a_request from the read-only RPCs to all of them.
A2A_ALLOW_WRITES=

# ── Inbound delivery ─────────────────────────────────────────────────────────
# Declare capabilities.experimental["claude/channel"] and push arriving tasks
# into an interactive Claude Code session — a true push, no parked tool call. On
# by default and harmless everywhere else: a client that does not understand the
# notification ignores it.
#
# It is a research preview, Claude Code only, and needs Anthropic auth (not
# Bedrock / Vertex / Foundry). So it is an enhancement over the long-poll, never
# the only route. Set to 0 to turn it off entirely.
# A2A_CHANNEL=1

# The longest a2a_wait_for_task may block, in seconds. 240 by default, which sits
# below every client's own tool-call ceiling on purpose — a call killed by the
# client is indistinguishable from a broken server.
#
#   Codex          hard-caps a tool call at exactly 300s
#   Bastion        callTimeout is 180s, so set 150 in a Bastion profile
#
# Bastion injects no variable a child could recognise it by, so this is a knob
# rather than something the server can detect.
# A2A_MAX_WAIT_SECONDS=240

# How often the shared store is re-scanned while polling, in milliseconds.
# A readdir plus one stat per task, so 1000 is already cheap for the handful of
# tasks this holds.
# A2A_POLL_INTERVAL_MS=1000

# ── Paths ────────────────────────────────────────────────────────────────────
# The shared task store. Defaults to $XDG_STATE_HOME/mcp-a2a, i.e.
# ~/.local/state/mcp-a2a.
#
# ⚠ BOTH PROCESSES MUST RESOLVE THE SAME PATH. Two different directories are two
#   disjoint stores and no task ever crosses between them. This is why it is
#   deliberately NOT declared as `stateEnv` in the Bastion catalog: Bastion
#   redirects those into each profile's own directory, which is right for a token
#   file and wrong for machine-wide shared state.
# A2A_STATE_DIR=~/.local/state/mcp-a2a

# Config file path. Defaults to $XDG_CONFIG_HOME/mcp-a2a/config.json. The file's
# schema is strict — a typo'd key is an error, because a silently ignored key
# looks exactly like "that setting had no effect".
# A2A_CONFIG=~/.config/mcp-a2a/config.json

# ── Optional tuning ──────────────────────────────────────────────────────────
# Retries for a peer answering 429 or 5xx, with exponential backoff. A 401 is
# never retried: the token is static, so there is nothing to remint.
# A2A_MAX_RETRIES=3

# Verbose logging, to stderr. stdout is the MCP protocol channel and carries
# nothing else, ever.
# A2A_DEBUG=1
